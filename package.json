{
  "name": "claude-lens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first analytics for your Claude Code harness. macOS, source-only.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "main": "out/main/index.cjs",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "postinstall": "electron-rebuild --force --only better-sqlite3-electron",
    "dev": "electron-vite dev",
    "guard": "node scripts/guard-repo.mjs",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --build --force",
    "build": "electron-vite build && node scripts/check-bundle-externals.mjs",
    "test": "vitest run",
    "check": "pnpm run guard && pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run test",
    "e2e": "pnpm run build && playwright test -c e2e/playwright.config.ts",
    "launcher": "node scripts/make-launcher.mjs"
  },
  "dependencies": {
    "@visx/visx": "4.0.0",
    "@xyflow/react": "12.11.2",
    "better-sqlite3": "12.11.1",
    "better-sqlite3-electron": "npm:better-sqlite3@12.11.1",
    "chokidar": "5.0.0",
    "cytoscape": "3.34.0",
    "d3-array": "3.2.4",
    "d3-sankey": "0.12.3",
    "d3-scale": "4.0.2",
    "framer-motion": "12.42.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "8.2.0",
    "recharts": "3.10.0",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "^24",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "electron": "42.7.0",
    "electron-vite": "5.0.0",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "29.1.1",
    "prettier": "3.9.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "better-sqlite3-electron",
      "electron"
    ]
  }
}
